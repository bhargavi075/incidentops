# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Authentication key for Groq LPU inference (e.g. gsk_...)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# HINDSIGHT_API_KEY: Authentication key for Hindsight Cloud
HINDSIGHT_API_KEY="your_hindsight_api_key_here"

# HINDSIGHT_BASE_URL: Hindsight Cloud endpoint
HINDSIGHT_BASE_URL="https://api.hindsight.vectorize.io"

# HINDSIGHT_BANK_ID: Persistent memory bank name
HINDSIGHT_BANK_ID="incidentops-bank"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

